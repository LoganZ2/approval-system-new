/* pages/profile/index.wxss */
.container {
  background: #f5f5f5;
  min-height: 100vh;
}

.user-info {
  background: #1890ff;
  color: white;
  padding: 60rpx 40rpx;
}

.avatar-section {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: white;
  margin-right: 30rpx;
}

.user-details {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.user-department {
  font-size: 28rpx;
  opacity: 0.8;
}

.menu-section {
  background: white;
  margin: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-title {
  font-size: 32rpx;
  color: #333;
}

.menu-arrow {
  color: #999;
  font-size: 28rpx;
}

.logout-section {
  margin: 40rpx 20rpx;
}

.logout-btn {
  background: #ff4d4f;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 32rpx;
}